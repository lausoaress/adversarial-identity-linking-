# Only needed if you switch config/config.yaml's llm.provider away from
# "ollama" (which needs no key — it talks to your local Ollama server).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only needed for src/data/loaders.py::load_reddit_api. Register a free
# "script" app at https://www.reddit.com/prefs/apps to get these — do not
# commit real values here, this file is the template (.env itself is
# git-ignored).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
